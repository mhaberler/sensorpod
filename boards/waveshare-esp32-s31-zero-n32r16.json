{
  "build": {
    "arduino": {
      "memory_type": "qio_opi",
      "partitions": "default_32MB.csv"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32S31_DEV",
      "-DBOARD_HAS_PSRAM",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_USB_CDC_ON_BOOT=1"
    ],
    "f_cpu": "320000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "psram_type": "opi",
    "hwids": [
      [
        "0x303A",
        "0x1001"
      ]
    ],
    "mcu": "esp32s31",
    "variant": "esp32s31"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "zigbee",
    "thread"
  ],
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": [
      "esp-builtin"
    ],
    "openocd_target": "esp32s31.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Waveshare ESP32-S31-Zero N32R16 (32 MB Flash, 16 MB Octal PSRAM)",
  "upload": {
    "flash_size": "32MB",
    "maximum_ram_size": 524288,
    "maximum_size": 33554432,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://www.waveshare.com/esp32-s31-zero.htm",
  "vendor": "Waveshare"
}
